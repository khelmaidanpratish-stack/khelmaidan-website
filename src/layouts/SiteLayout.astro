---
import '../styles/global.css';
const { title = 'KhelMaidan | Sports, in focus', description = 'Football, cricket, volleyball and more.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [['Home','/'],['Football','/football/'],['Cricket','/cricket/'],['Volleyball','/volleyball/'],['Extras','/extras/']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#071d14" />
  <link rel="icon" type="image/svg+xml" href="/images/khelmaidan-mark.svg" />
  <link rel="alternate icon" href="/images/khelmaidan-mark.svg" />
  <title>{title}</title>
</head>
<body>
  <div class="topline"><div class="wrap topline__inner"><strong>KHELMAIDAN</strong><span>Independent sports coverage · Built for the fans</span></div></div>
  <header class="site-header">
    <div class="header-inner wrap">
      <a class="brand" href="/" aria-label="KhelMaidan home"><img class="brand-logo" src="/images/khelmaidan-logo.svg" alt="KhelMaidan" /></a>
      <button class="menu-button" aria-label="Open navigation" aria-expanded="false"><span></span><span></span><span></span></button>
      <nav class="main-nav" aria-label="Main navigation">
        {nav.map(([label,href]) => <a class={path === href ? 'active' : ''} href={href}>{label}</a>)}
      </nav>
      <a class="header-search" href="#latest" aria-label="Jump to latest news">Latest <span>→</span></a>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div><a class="brand brand--footer" href="/"><img class="brand-logo brand-logo--footer" src="/images/khelmaidan-logo.svg" alt="KhelMaidan" /></a><p>Football first. Cricket, volleyball and the wider world of sport.</p></div>
      <div><h3>Sections</h3><a href="/football/">Football</a><a href="/cricket/">Cricket</a><a href="/volleyball/">Volleyball</a><a href="/extras/">Extras</a></div>
      <div><h3>KhelMaidan</h3><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a></div>
    </div>
    <div class="wrap footer-bottom"><span>© {new Date().getFullYear()} KhelMaidan</span><span>Sports, in focus.</span></div>
  </footer>
  <script is:inline>
    const btn=document.querySelector('.menu-button'); const nav=document.querySelector('.main-nav');
    btn?.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open');});
  </script>
</body>
</html>
