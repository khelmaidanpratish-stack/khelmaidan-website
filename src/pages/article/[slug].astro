---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getArticles, formatPublicationDate, getArticleImage, getFallbackImage } from '../../lib/articles.js';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article.entry);
const articleImage = getArticleImage(article);
const fallbackImage = getFallbackImage(article.category);
---
<SiteLayout title={`${article.title} | KhelMaidan`} description={article.excerpt}>
  <article class="article wrap">
    <a class="back-link" href={`/${article.category.toLowerCase()}/`}>← Back to {article.category}</a>
    <p class="eyebrow">{article.category} · {formatPublicationDate(article.publishedAt, { year: 'numeric', month: 'long', day: 'numeric' })}</p>
    <h1>{article.title}</h1>
    <p class="article-deck">{article.excerpt}</p>
    <p class="muted">By {article.author}</p>
    <img class="article-image" src={articleImage} alt="" onerror={`this.onerror=null;this.src='${fallbackImage}'`} />
    <div class="article-body"><Content /></div>
  </article>
</SiteLayout>
