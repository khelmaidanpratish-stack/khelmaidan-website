---
import SiteLayout from '../../layouts/SiteLayout.astro';
import NewsCard from '../../components/NewsCard.jsx';
import { getArticles } from '../../lib/articles.js';
const articles = await getArticles();
const items = articles.filter((a) => a.category === 'Extras');
---
<SiteLayout title="Extras | KhelMaidan" description="Features, opinions and sports explainers from KhelMaidan.">
  <section class="category-hero wrap"><p class="eyebrow">Beyond the headlines</p><h1>Extras</h1><p>Opinion, explainers, interviews and long-form sports stories.</p></section>
  <section class="wrap section"><div class="news-grid">{items.map((article) => <NewsCard article={article} />)}</div></section>
</SiteLayout>
