---
import SiteLayout from "../../layouts/SiteLayout.astro";
import NewsCard from "../../components/NewsCard.jsx";
import { getArticles } from "../../lib/articles.js";
const articles = await getArticles();
const items = articles.filter((a) => a.category === "Volleyball");
---
<SiteLayout title="Volleyball | KhelMaidan" description="Volleyball news and coverage from KhelMaidan.">
  <section class="category-hero wrap"><p class="eyebrow">KhelMaidan / Sport</p><h1>Volleyball</h1><p>Stories from the court, competitions and communities.</p></section>
  <section class="wrap section"><div class="news-grid">{items.map((article) => <NewsCard article={article} />)}</div></section>
</SiteLayout>
