---
import SiteLayout from "../../layouts/SiteLayout.astro";
import NewsCard from "../../components/NewsCard.jsx";
import { articles } from "../../data/articles.js";
const items = articles.filter((a) => a.category === "Volleyball").sort((a,b) => new Date(b.publishedAt)-new Date(a.publishedAt));
---
<SiteLayout title="Volleyball | KhelMaidan" description="Volleyball news and coverage from KhelMaidan.">
  <section class="category-hero wrap"><p class="eyebrow">KhelMaidan / Sport</p><h1>Volleyball</h1><p>Stories from the court, competitions and communities.</p></section>
  <section class="wrap section"><div class="news-grid">{items.map((article) => <NewsCard article={article} client:load />)}</div></section>
</SiteLayout>
